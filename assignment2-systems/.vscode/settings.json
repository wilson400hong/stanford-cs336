{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.activeInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/cs336-basics",
    "${workspaceFolder}/.venv/lib/python3.12/site-packages"
  ],
  "python.autoComplete.extraPaths": [
    "${workspaceFolder}/cs336-basics",
    "${workspaceFolder}/.venv/lib/python3.12/site-packages"
  ],
  "python.pyrefly.displayTypeErrors": "force-off",
  "python.pyrefly.diagnosticMode": "openFilesOnly",
  "pyrefly.trace.server": "off",
  "python.analysis.typeCheckingMode": "off",
  "python.languageServer": "Default",
  "python.experiments.enabled": false,
  "pyls.automaticWorkspaceOverrides": false
}
